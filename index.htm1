<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>A little something</title>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Parisienne&display=swap');

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;

            display: flex;
            justify-content: center;
            align-items: center;

            overflow: hidden;

            background:
                radial-gradient(
                    ellipse at 50% 45%,
                    #294432 0%,
                    #1c3023 30%,
                    #111b15 58%,
                    #070b08 100%
                );

            color: #d8d4c6;
        }

        .opening {
            width: 100%;
            min-height: 100vh;

            display: flex;
            flex-direction: column;

            justify-content: center;
            align-items: center;

            text-align: center;

            position: relative;
        }

        .top-decoration {
            font-family: "Cormorant Garamond", serif;

            font-size: 18px;

            letter-spacing: 5px;

            color: #71836f;

            margin-bottom: 22px;

            opacity: 0.9;
        }

        .small-text {
            font-family: "Cormorant Garamond", serif;

            font-size: 19px;

            letter-spacing: 3px;

            color: #a8ad9d;

            margin-bottom: 8px;
        }

        .main-text {
            font-family: "Cormorant Garamond", serif;

            font-size: 25px;

            letter-spacing: 3px;

            color: #c2b39c;

            margin-bottom: 38px;
        }

        .gift-wrapper {
            position: relative;

            width: 230px;
            height: 220px;

            cursor: pointer;

            transition: transform 0.4s ease;
        }

        .gift-wrapper:hover {
            transform: translateY(-7px);
        }

        .gift-shadow {
            position: absolute;

            bottom: 0;
            left: 50%;

            width: 190px;
            height: 30px;

            transform: translateX(-50%);

            background: rgba(0, 0, 0, 0.45);

            border-radius: 50%;

            filter: blur(12px);
        }

        .box {
            position: absolute;

            left: 25px;
            bottom: 25px;

            width: 180px;
            height: 125px;

            background:
                linear-gradient(
                    135deg,
                    #304a37,
                    #203427 55%,
                    #17271d
                );

            border: 1px solid #596b58;

            border-radius: 8px;

            box-shadow:
                0 20px 35px rgba(0, 0, 0, 0.45);

            z-index: 2;
        }

        .ribbon-vertical {
            position: absolute;

            left: 50%;
            top: 0;

            width: 30px;
            height: 100%;

            transform: translateX(-50%);

            background:
                linear-gradient(
                    90deg,
                    #80684d,
                    #a38a68,
                    #80684d
                );

            opacity: 0.9;
        }

        .ribbon-horizontal {
            position: absolute;

            left: 0;
            top: 42px;

            width: 100%;
            height: 30px;

            background:
                linear-gradient(
                    180deg,
                    #80684d,
                    #a38a68,
                    #80684d
                );

            opacity: 0.9;
        }

        .lid {
            position: absolute;

            left: 13px;
            bottom: 143px;

            width: 204px;
            height: 42px;

            background:
                linear-gradient(
                    135deg,
                    #3a5540,
                    #263d2e
                );

            border: 1px solid #637360;

            border-radius: 7px;

            box-shadow:
                0 10px 20px rgba(0, 0, 0, 0.35);

            z-index: 4;

            transition:
                transform 1s cubic-bezier(.68,-0.55,.27,1.55),
                opacity 0.7s ease;
        }

        .lid-ribbon {
            position: absolute;

            left: 50%;
            top: 0;

            width: 30px;
            height: 100%;

            transform: translateX(-50%);

            background:
                linear-gradient(
                    90deg,
                    #80684d,
                    #a38a68,
                    #80684d
                );
        }

        .bow {
            position: absolute;

            left: 50%;
            top: -27px;

            width: 75px;
            height: 48px;

            transform: translateX(-50%);

            z-index: 6;
        }

        .bow-left,
        .bow-right {
            position: absolute;

            width: 42px;
            height: 30px;

            background: #927856;

            border: 1px solid #b29a78;

            border-radius: 50% 50% 45% 45%;
        }

        .bow-left {
            right: 35px;

            transform: rotate(25deg);
        }

        .bow-right {
            left: 35px;

            transform: rotate(-25deg);
        }

        .bow-center {
            position: absolute;

            left: 50%;
            top: 8px;

            width: 22px;
            height: 22px;

            transform: translateX(-50%);

            background: #a38a68;

            border-radius: 50%;

            z-index: 2;
        }

        .click-text {
            margin-top: 35px;

            font-family: "Cormorant Garamond", serif;

            font-size: 16px;

            letter-spacing: 3px;

            color: #9ba492;

            transition: opacity 0.4s ease;
        }

        .click-text span {
            color: #c2b39c;
        }

        .gift-wrapper.open .lid {
            transform:
                translateY(-80px)
                rotate(-8deg);

            opacity: 0;
        }

        .gift-wrapper.open .bow {
            transform:
                translateX(-50%)
                translateY(-80px)
                rotate(-8deg);

            opacity: 0;

            transition:
                transform 1s ease,
                opacity 0.7s ease;
        }

        .gift-wrapper.open {
            transform: translateY(-5px) scale(1.03);
        }

        .gift-wrapper.open + .click-text {
            opacity: 0;
        }

        @media (max-width: 600px) {

            .main-text {
                font-size: 22px;
            }

            .gift-wrapper {
                transform: scale(0.9);
            }

            .gift-wrapper:hover {
                transform: scale(0.9) translateY(-5px);
            }
        }
    </style>
</head>

<body>

    <main class="opening">

        <div class="top-decoration">
            ✦ ୨୧ ✦
        </div>

        <div class="small-text">
            a little something
        </div>

        <div class="main-text">
            just for you
        </div>

        <div class="gift-wrapper" id="gift">

            <div class="gift-shadow"></div>

            <div class="box">

                <div class="ribbon-vertical"></div>

                <div class="ribbon-horizontal"></div>

            </div>

            <div class="lid">

                <div class="lid-ribbon"></div>

            </div>

            <div class="bow">

                <div class="bow-left"></div>
                <div class="bow-right"></div>
                <div class="bow-center"></div>

            </div>

        </div>

        <div class="click-text">
            <span>✦</span> click on the box <span>✦</span>
        </div>

    </main>

    <script>

        const gift = document.getElementById("gift");

        gift.addEventListener("click", () => {

            gift.classList.add("open");

        });

    </script>

</body>
</html>
